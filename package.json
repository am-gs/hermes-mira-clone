{
  "name": "hermes-mira-clone",
  "version": "1.0.0",
  "description": "Production-ready 1:1 Mira clone for Hermes Agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "ai",
    "streaming",
    "mtproto"
  ],
  "author": "Hermes Agent",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.25.0",
    "telegram": "^2.22.2",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.24.0",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "prom-client": "^15.1.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2",
    "vitest": "^2.0.3",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
